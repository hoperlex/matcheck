# Server
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# Database (заполняется в Фазе 1)
# DATABASE_URL=postgres://user:password@host:6432/matcheck?sslmode=verify-full

# Redis (заполняется в Фазе 1)
# REDIS_URL=redis://localhost:6379

# Field-level encryption (заполняется в Фазе 1)
# Этот же keyring — источник ключа для вывода refresh-токенов замены
# (domain/auth/crypto.ts), поэтому на проде дефолтный ключ недопустим.
# APP_FIELD_ENCRYPTION_KEYS={"v1":"<base64-32B>"}
# APP_FIELD_ENCRYPTION_ACTIVE_KEY_VERSION=v1

# Окно идемпотентного повтора refresh, секунды (0..300, умолчание 60).
# 0 — выключить повтор и вернуться к прежнему «любой reuse убивает сессию».
# REFRESH_REUSE_GRACE_SECONDS=60

# Публичная форма /uploads — потолки приёма (считают ЗАПРОСЫ, не файлы).
# Умолчания согласованы с мощностью воркера при CONCURRENCY=1; подробности
# и порядок изменения — в infra/api.env.example и docs/DEPLOY.md.
# PUBLIC_UPLOAD_GLOBAL_MAX=200
# PUBLIC_UPLOAD_IP_MAX=20

# Нормализация УПД без стоимостной части. До A/B оставлять выключенной.
# UPD_NO_PRICING_V1=0
# Второй проход накладных промптом формы 1-Т: включается, только когда
# первый проход (ТН-2116/ОС-2) вернул пустой список.
# WAYBILL_1T_FALLBACK=0

# Границы документов в многостраничном файле и следы потерь при нарезке.
# Все три выключены: выкладка кода не меняет распознавание, включение —
# отдельное решение и требует ПЕРЕЗАПУСКА воркеров (loadEnv кэширует конфиг).
#
# Аудит нумерации: помечает пакет, если в файле были неразобранные страницы
# или в номерах документов пропуск. Только пометка — статус документа, его
# публикация и выдача на планшет не меняются.
# UPD_ASSEMBLY_NUMBER_AUDIT=0
#
# Откат сборки уважает вид документа: файл, целиком состоящий из страниц
# накладной, уходит в waybill-парсер, а не в УПД. off|shadow|on.
# UPD_ASSEMBLY_ROLLBACK_KIND=off
#
# Нарезка по номеру документа: страница с чужим номером открывает свой
# документ. Лечит молчаливую потерю УПД, чью шапку приняли за оборот
# предыдущей. off|shadow|on; shadow добавляет один vision-вызов на порцию
# из 15 страниц и применяет ПРЕЖНИЙ план.
# UPD_ASSEMBLY_SPLIT_BY_DOC_NUMBER=off
# Потолок ответа классификатора для расширенного промпта (с номерами).
# UPD_ASSEMBLY_CLASSIFY_MAX_TOKENS=3072
#
# Фрагмент, у которого совпали поставщик, номер и итог, но разошлась ДАТА,
# присоединяется к своей УПД вместо публикации вторым документом (приёмка
# 13776: позиция попадала в учёт дважды). off|shadow|on; в shadow кандидаты
# только пишутся в улику. Две одиночки между собой не склеиваются ни в одном
# режиме.
# UPD_ASSEMBLY_RELAXED_COPY=off

# Единица измерения позиции: брать из документа, когда планшет прислал «шт».
# Планшет теряет её на финализации 2 Этапа — на бою так испорчено 2989 позиций
# из 3068 за 30 дней («84 м» кабеля становились «84 шт»).
#   off    — выключено (по умолчанию), лишних запросов к позициям документа нет
#   shadow — считаем и пишем в лог, данные не меняем
#   on     — подставляем единицу документа
# Только запросы планшета (X-Client-Type: mobile) на статус confirmed_mol:
# на портале единицу выбирают руками, и её подменять нельзя.
UNIT_FROM_DOCUMENT=off
