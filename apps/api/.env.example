# Server
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# Database (заполняется в Фазе 1)
# DATABASE_URL=postgres://user:password@host:6432/matcheck?sslmode=verify-full

# Redis (заполняется в Фазе 1)
# REDIS_URL=redis://localhost:6379

# Field-level encryption (заполняется в Фазе 1)
# Этот же keyring — источник ключа для вывода refresh-токенов замены
# (domain/auth/crypto.ts), поэтому на проде дефолтный ключ недопустим.
# APP_FIELD_ENCRYPTION_KEYS={"v1":"<base64-32B>"}
# APP_FIELD_ENCRYPTION_ACTIVE_KEY_VERSION=v1

# Окно идемпотентного повтора refresh, секунды (0..300, умолчание 60).
# 0 — выключить повтор и вернуться к прежнему «любой reuse убивает сессию».
# REFRESH_REUSE_GRACE_SECONDS=60

# Публичная форма /uploads — потолки приёма (считают ЗАПРОСЫ, не файлы).
# Умолчания согласованы с мощностью воркера при CONCURRENCY=1; подробности
# и порядок изменения — в infra/api.env.example и docs/DEPLOY.md.
# PUBLIC_UPLOAD_GLOBAL_MAX=200
# PUBLIC_UPLOAD_IP_MAX=20
