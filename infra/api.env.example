# Шаблон env-файла для matcheck-api контейнера.
#
# Реальный файл создаётся на VPS в /srv/matcheck/secrets/api.env
# с правами 600 и owner matcheck:matcheck. В репозитории он
# отсутствует намеренно — секреты вне VCS.
#
# Все <значения-в-угловых-скобках> заменить на реальные.

# =============== Runtime ===============
NODE_ENV=production
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# Инструментовка запросов: на каждый HTTP-ответ пишется строка `req-metric`
# с route/method/status/durMs/sql/respBytes/role. Допустимы только '0' и '1'.
#   0 — плагин не вешает хуки вовсе, оверхед нулевой (значение по умолчанию).
#   1 — метрики пишутся в лог контейнера.
# Включать ВРЕМЕННЫМ ОКНОМ для замера (baseline перед оптимизацией и контроль
# после), затем возвращать 0: строка на каждый ответ быстро раздувает логи.
REQUEST_METRICS_ENABLED=0

# Применение матрицы прав ролей («Администрирование» → «Роли»).
# Допустимы только '0' и '1'.
#   0 — матрицу можно настраивать, но сервер её не применяет, а UI получает
#       дефолтные права. Это исходное поведение системы и способ мгновенного
#       отката: поставить 0 и перезапустить контейнер (overrides в БД
#       сохраняются и оживут при обратном включении).
#   1 — матрица применяется: запрещённое действие отдаёт 403.
# Включать только после мобильного smoke на планшете КПП.
PERMISSIONS_ENFORCE=0

# Сборка логических УПД: страницы одной УПД склеиваются в ОДИН документ вместо
# «файл = документ». Допустимы только '0' и '1'.
#   0 — прежний пофайловый разбор (значение по умолчанию).
#   1 — пакеты ПУБЛИЧНОЙ формы (mat.su10.ru/uploads, direction=inbound)
#       классифицируются постранично и собираются в логические документы.
# Что это меняет на практике: шесть фотографий одной машины перестают быть
# шестью документами (две страницы одной УПД — дубликат, страница без шапки —
# пустой обрубок) и становятся тремя нормальными.
# Любой сбой сборки — откат на прежний путь: файлы не теряются.
# Внутренняя загрузка на портале, почта и ЭДО флагом не затрагиваются.
UPD_ASSEMBLY_V1=0

# Склейка двух ЭКЗЕМПЛЯРОВ одной УПД (поставщик отсканировал оба — продавца и
# покупателя). Строки сопоставляются один-к-одному по напечатанному номеру
# позиции, числам и наименованию, а не дедуплицируются по тексту: OCR читает
# два скана одной страницы по-разному («МК-103» и «МК --103»), и прежний ключ
# оставлял обе строки — 4 позиции вместо 2 и удвоенный итог.
# Заявленный итог из шапки у копий больше не подменяется суммой строк.
UPD_ASSEMBLY_COPY_DEDUP_V1=0

# Автоповтор распознавания сегмента, когда валидация нашла расхождение сумм
# (потеряна или задвоена строка). Повторяются ТОЛЬКО страницы этого сегмента по
# манифесту bundle_segments, и только пока комплект не опубликован: приёмок и
# ручных правок в этот момент ещё не существует.
#   off    — задание не ставится, поведение прежнее (значение по умолчанию);
#   shadow — повтор выполняется и пишет своё решение в second_pass, но результат
#            НЕ применяется: распознанные данные не меняются;
#   on     — кандидат заменяет разбор, если доказуемо лучше (покрытие проверок
#            не упало, провалов стало меньше, улучшение строк подтверждено).
# Кандидат, «починивший» расхождение подгонкой итога под свой неполный список,
# отклоняется — материалов от этого не прибавляется.
UPD_SEGMENT_REPAIR=off

# Порядок файлов в пакете перестаёт решать судьбу нарезки. Допустимы только
# '0' и '1'.
#   0 — прежнее поведение (значение по умолчанию).
#   1 — если страница с шапкой загружена ВТОРОЙ, она всё равно открывает
#       документ: план строится повторно с ней впереди.
# Что это меняет на практике: инспектор выбирает файлы в проводнике в
# произвольном порядке, и двухстраничная УПД, у которой первым оказалось
# продолжение, перестаёт разваливаться на два документа с одним номером
# (второй из них помечался дубликатом, а первый терял половину позиций).
# Условие узкое: ровно два одностраничных файла, одна шапка, одно продолжение.
# Пакеты с несколькими УПД и многостраничные PDF флагом не затрагиваются.
# ВКЛЮЧЕНИЕ ТРЕБУЕТ ПЕРЕЗАПУСКА matcheck-worker: loadEnv кэширует разобранное
# окружение, подмена переменной без рестарта процесса ничего не даст.
UPD_ASSEMBLY_REORDER_V1=0

# Нулевые итоги у документов, где новая версия УПД-промпта явно вернула
# pricing='absent' и ни одной цены структурно нет. Включать только после A/B;
# выкладка кода и неактивного промпта сама поведение не меняет.
UPD_NO_PRICING_V1=0
# Второй проход накладных промптом формы 1-Т (Госкомстат №78, ОКУД 0345009).
# Запускается ТОЛЬКО когда первый проход не нашёл ни ТН-2116, ни ОС-2, —
# то есть на файлах, которые сегодня оседают в «не распознано».
WAYBILL_1T_FALLBACK=0

# Прицельный маршрут для формы 1-Т: файл с признаками бланка (ОКУД 0345009,
# «Типовая межотраслевая форма № 1-Т», товарный раздел) уходит СРАЗУ к своему
# промпту. Без этого его забирает промпт ТН-2116, который 1-Т игнорировать
# обязан, а на деле читает по чужим колонкам: в количество попадает графа
# «Кол-во мест», в цену — количество.
# Применяется только к ОДНОРОДНОМУ пакету (все файлы — 1-Т), иначе соседние
# ТН-2116 и ОС-2 остались бы без разбора.
WAYBILL_1T_ROUTE=0

# Excel, непонятный структурному парсеру, отдаём модели, а не в заглушку.
# Книга с сигналом excel:not-upd рендерится в PDF и доклассифицируется по
# картинке: назвала товарный документ — идёт в УПД-путь, сказала unknown —
# прежняя заглушка «не распознано». Выключение возвращает прежнее поведение.
EXCEL_VISION_ROUTING=0

# Книга Excel с бланком транспортной накладной — к промпту накладных, а не в
# заглушку. Признак текстовый и детерминированный (заголовок формы + минимум
# два именованных раздела бланка: «1. Грузоотправитель», «6. Перевозчик» и
# далее), проверяется ПОСЛЕ структурной пробы parseUpdXlsx — то есть только у
# книг с сигналом excel:not-upd. Книга, в которой парсер нашёл хоть одно поле
# шапки или хоть одну позицию, остаётся УПД, как и раньше.
# В отличие от EXCEL_VISION_ROUTING модель на этапе классификации не зовётся;
# сам разбор дальше идёт через parseWaybillBatch, и это уже LLM-вызов.
EXCEL_WAYBILL_TEXT_ROUTE=0

# Потолок страниц на пакет для сборки. Двадцать разрешённых PDF дают сотни
# страниц: это десятки vision-вызовов в воркере с CONCURRENCY=1, то есть
# вставшая очередь. При превышении пакет уходит прежним путём.
UPD_ASSEMBLY_MAX_TOTAL_PAGES=40

# Сторож распознавания: подбирает записи, чьё задание умерло. Живой пример —
# воркер перезапустили посреди распознавания (деплой): lock перестаёт
# продлеваться, BullMQ засчитывает срыв, и после лимита срывов задание уходит в
# failed. Само оно уже не оживёт, документ остаётся в queued навсегда.
# Допустимы 'off', 'dry_run', 'on'.
#   off     — не трогает ничего (значение по умолчанию);
#   dry_run — только пишет в лог, что переставил бы; ничего не меняет;
#   on      — переставляет работу с новым поколением задания и терминализует
#             запись по исчерпании попыток (их две).
# Порог — 45 минут без движения; прогон раз в 10 минут, первый — через минуту
# после старта воркера.
#
# ВКЛЮЧАТЬ ТОЛЬКО ПОСЛЕ ДЕПЛОЯ ВСЕХ ВОРКЕРОВ: иначе старый воркер запишет
# результат поверх нового поколения. Значение читается один раз при старте,
# поэтому смена режима требует пересоздания контейнера:
#   docker compose -f infra/docker-compose.prod.yml up -d --force-recreate matcheck-worker
# Порядок выката: dry_run → посмотреть в логах (task=stuck-jobs), что именно он
# собирается взять → on.
#
# Чем грозит off. 18.08.2026 рестарт воркера убил задание сегмента сборки:
# пакет провисел в processing 30 часов, две фотографии всё это время висели у
# менеджера строкой «в очереди» без единой кнопки, документы по ним не
# появлялись. Подобрать мёртвое задание, кроме этого сторожа, некому.
RECOGNITION_RECOVERY_MODE=off

# Кнопка ручного восстановления в карточке документа — отдельно от сторожа выше
# и по плану выката включается ПОСЛЕДНЕЙ: у человека нет ограничения по частоте,
# и ошибка в fencing проявится через него быстрее всего.
# Допустимы только '0' и '1'.
# Поднимает только обычные документы: служебные записи пакета и сегменты сборки
# ею не достать — в интерфейсе их нет, их подбирает лишь сторож.
RECOGNITION_RECOVERY_MANUAL=0

# =============== CORS / Cookies ===============
CORS_ORIGIN=https://matcheck.fvds.ru
COOKIE_DOMAIN=matcheck.fvds.ru
COOKIE_SECURE=true

# Внешний адрес портала для ссылок, которые уходят людям наружу: публичный
# просмотр приёмки (/share/...) и сброс пароля (/reset-password#...).
#
# ОБЯЗАТЕЛЕН в production для сброса пароля: без него выдача ссылки ответит
# ошибкой. Подставлять адрес из заголовка Host нельзя — подделанный Host увёл
# бы ссылку на чужой домен, а это ссылка, задающая пароль к учётной записи.
# Значение задаётся ДО выката кода: файл общий для api, worker и mail-worker.
PUBLIC_BASE_URL=https://mat.su10.ru

# Случайная строка ≥ 32 символа: openssl rand -base64 48
CSRF_SECRET=<32+ случайных байт base64>

# =============== JWT (Ed25519) ===============
# PEM-ключи в одну строку с буквальным escape \n. Получить:
#   awk 'NF {sub(/\r/, ""); printf "%s\\n", $0}' /srv/matcheck/secrets/jwt-private.pem
#   awk 'NF {sub(/\r/, ""); printf "%s\\n", $0}' /srv/matcheck/secrets/jwt-public.pem
JWT_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n<вставить вывод awk>\n-----END PRIVATE KEY-----\n"
JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n<вставить вывод awk>\n-----END PUBLIC KEY-----\n"

JWT_ISSUER=matcheck-api
JWT_AUDIENCE=matcheck-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
REFRESH_TOKEN_ABSOLUTE_MAX_DAYS=90

# Окно идемпотентного повтора refresh: сколько секунд после ротации сервер
# принимает СТАРЫЙ токен, отдавая ту же замену вместо того, чтобы счесть повтор
# кражей и убить сессию. Лечит «Сессия истекла» у клиента, до которого не дошёл
# ответ (оборванный по таймауту запрос, потерянный Set-Cookie, два параллельных
# refresh). Диапазон 0..300; 0 — аварийно выключить повтор (вернуться к старому
# поведению без релиза). Пустое значение НЕ означает 0 — берётся умолчание 60.
REFRESH_REUSE_GRACE_SECONDS=60

# =============== Шифрование чувствительных полей БД (AES-256-GCM) ===============
# Map версия → base64 32-байтного ключа. При потере ключа Mail/EDO/LLM
# credentials восстановить НЕВОЗМОЖНО. Сгенерировать:
#   openssl rand -base64 32
# Этот же keyring — источник ключа для выпуска refresh-токенов замены
# (domain/auth/crypto.ts), поэтому на проде значение обязано быть настоящим:
# с публичным нулевым умолчанием вывод замены перестал бы быть секретом.
# При ротации ключа старую версию НЕ удалять, пока живы выпущенные на ней
# refresh-цепочки (не меньше REFRESH_TOKEN_TTL_DAYS) — иначе повтор перестанет
# обслуживаться и людей начнёт разлогинивать.
APP_FIELD_ENCRYPTION_KEYS={"v1":"<base64 32 байта>"}
APP_FIELD_ENCRYPTION_ACTIVE_KEY_VERSION=v1

# =============== PostgreSQL (Yandex Managed) ===============
# Кавычки ОБЯЗАТЕЛЬНЫ — в URL есть &, без кавычек shell сломает.
# sslmode=verify-full + sslrootcert указывает на CA внутри контейнера
# (смонтированный из /srv/matcheck/secrets/yandex-ca/root.crt).
DATABASE_URL="postgres://<USER>:<PASSWORD>@<HOST>.mdb.yandexcloud.net:6432/<DBNAME>?sslmode=verify-full&sslrootcert=/etc/ssl/yandex/root.crt"

# CA для TLS-handshake к Yandex PG. postgres-js не парсит sslrootcert
# из URL, поэтому путь нужно дополнительно отдать Node через
# NODE_EXTRA_CA_CERTS. Без этого подключение падает с
# "self-signed certificate in certificate chain".
NODE_EXTRA_CA_CERTS=/etc/ssl/yandex/root.crt

# =============== БД ФОТ (read-only, внешняя) — список МОЛ ===============
# Отдельный read-only аккаунт (только SELECT) к Yandex Managed PG ФОТ.
# Тот же Yandex CA, что и основная БД — отдельный сертификат не нужен,
# NODE_EXTRA_CA_CERTS выше покрывает и это подключение.
# Если переменная не задана — раздел Справочники → МОЛ отдаёт пустой
# список с флагом «список мог устареть», приложение не падает.
FOT_DATABASE_URL="postgresql://mcp_readonly:<PASSWORD>@rc1d-m4ubd0uem0j9gqqc.mdb.yandexcloud.net:6432/FOT_Prod?sslmode=verify-full&sslrootcert=/etc/ssl/yandex/root.crt"

# =============== Redis (свой контейнер matcheck-redis) ===============
REDIS_URL=redis://matcheck-redis:6379/0

# =============== S3 (Cloud.ru Object Storage) ===============
S3_ENDPOINT=https://s3.cloud.ru
S3_REGION=ru-central-1
S3_BUCKET=<имя_бакета>
S3_ACCESS_KEY_ID=<...>
S3_SECRET_ACCESS_KEY=<...>

# =============== Почта: приём УПД от подрядчиков ===============
# Отдельный контейнер matcheck-mail-worker. Файл общий с API и worker, но
# опрос ящиков включается ДВУМЯ независимыми выключателями:
#   1. MAIL_POLL_ENABLED здесь;
#   2. poll_enabled у конкретного ящика в админке (Админ → Почта).
# Без обоих контейнер живёт, но сам не опрашивает ничего — доступен только
# ручной запуск «Проверить сейчас», которым проверяют доступы до включения.
#
# Порядок запуска почты:
#   1) завести ящик в админке (IMAP-хост, порт 993, TLS, пароль приложения);
#   2) нажать «Проверить сейчас» — письма при этом НЕ помечаются прочитанными
#      и не удаляются, ящик можно параллельно смотреть обычной почтой;
#   3) убедиться, что письма появились, и только потом включить автоопрос.
MAIL_POLL_ENABLED=false
# Как часто обходить включённые ящики, секунды.
MAIL_POLL_INTERVAL_SEC=120
# Сколько писем забирать за один проход.
MAIL_POLL_MAX_MESSAGES=50
# Срок аренды ящика воркером: защита от двойного опроса, секунды.
MAIL_POLL_LEASE_SEC=900
# Предел размера письма целиком — 20 МБ. Держится кратно ниже mem_limit
# контейнера (384 МБ): письмо существует в памяти сырым буфером,
# MIME-структурой и декодированными вложениями одновременно, то есть пик втрое
# выше самого размера. VPS делит память с соседними проектами, поэтому предел
# занижен осознанно.
#
# Письмо больше предела НЕ теряется: оно не скачивается и попадает в список
# незабранных на вкладке «Разбор почты». Оттуда его можно затребовать повторно,
# предварительно подняв лимит здесь и перезапустив matcheck-mail-worker.
MAIL_LETTER_MAX_BYTES=20971520
# Вложение по определению меньше письма — предел держим согласованным.
MAIL_ATTACHMENT_MAX_BYTES=15728640
# Защита от zip-бомбы в xlsx: три независимых предела.
MAIL_XLSX_MAX_ENTRIES=512
MAIL_XLSX_MAX_INFLATED_BYTES=104857600
MAIL_XLSX_MAX_RATIO=200
# Срок хранения разобранной почты, дни. 0 — НЕ УДАЛЯТЬ (значение по умолчанию).
#
# Письма лежат в объектном хранилище (S3), а не на диске сервера: при двадцати
# письмах в день это порядка 2–3 ГБ в год. Оригинал письма — доказательство
# «подрядчик прислал вот это и вот тогда», поэтому автоудаление включается
# только осознанно.
#
# Если задать срок: удаляются ТОЛЬКО сырое письмо (.eml) и временные копии
# вложений, и только у писем, с которыми уже разобрались. Документы, их
# постоянные файлы, приёмки и фото НЕ затрагиваются — у документа своя копия
# файла. Письма, ожидающие разбора, не удаляются никогда.
MAIL_RETENTION_DAYS=0

# =============== Публичная форма /uploads — потолки приёма ===============
# Обе величины считают ЗАПРОСЫ, не файлы. По боевым манифестам на запрос
# приходится ~1,1 файла, то есть 200 запросов/час ≈ 220 файлов/час — ровно
# столько разбирает воркер при CONCURRENCY=1 (200–300 файлов/час). Поднимать
# вслепую нельзя: очередь начнёт копиться, а поставщик будет ждать статус.
#
# В день массовой загрузки смотреть в логи API по строке «public upload:
# принято»: там же поле updParseWaiting — глубина очереди на момент приёма.
# Растёт от отправки к отправке — потолок уже упёрся в мощность разбора.
# Глобальный лимит на всю форму, запросов в час.
PUBLIC_UPLOAD_GLOBAL_MAX=200
# Лимит на один IP, запросов за 10 минут. За одним внешним адресом может
# сидеть весь офис подрядчика — ниже 20 не опускать.
PUBLIC_UPLOAD_IP_MAX=20

# =============== Sentry (мониторинг ошибок API + worker) ===============
# DSN проекта matcheck-api (публичный, можно хранить как обычную переменную).
# Если не задан — Sentry.init не вызывается (события не шлются). Один файл общий
# для контейнеров matcheck-api и matcheck-worker.
SENTRY_DSN=<https://xxxx@oXXXX.ingest.sentry.io/XXXX>
SENTRY_ENVIRONMENT=production
# Доля трасс (0..1). 0 = только ошибки, без performance-трейсинга.
SENTRY_TRACES_SAMPLE_RATE=0.1
# Версия релиза (обычно git SHA), для группировки. Опционально.
# SENTRY_RELEASE=<git-sha>

# Санитизация тела необработанных 5xx: клиент вместо текста исключения (там
# оказывался SQL с параметрами) получает {error, message, requestId}.
# ЕДИНСТВЕННЫЙ глобальный onSend-хук приложения — 20.08 он в паре с SSE
# уронил боевой API 854 раза. Рубильник нужен, чтобы в аварии снять хук
# перезапуском контейнера, а не пересборкой образа.
# Логирование http_5xx от него не зависит: оно висит на onResponse.
ERROR_VISIBILITY_SANITIZE=1
