{
  "mcpServers": {
    "matcheck-db": {
      "command": "/usr/bin/env",
      "args": [
        "-u",
        "MATCHECK_DB_RO_URL",
        "/usr/local/bin/node",
        "--env-file=/root/projects/matcheck/infra/secrets/mcp-db.env",
        "/root/projects/matcheck/tools/mcp-pg/server.mjs"
      ],
      "env": {
        "NODE_EXTRA_CA_CERTS": "/root/projects/matcheck/infra/secrets/yandex-ca/root.crt"
      }
    }
  }
}
